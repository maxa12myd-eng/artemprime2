dialog_lines = [
    {who: "narrator",    text: "Лаборатория Жеки T-3000."},
    {who: "narrator",    text: "Всюду провода, экраны, мигающие лампочки."},
    {who: "narrator",    text: "На столах - железки, гайки, схемы."},
    {who: "artem",       text: "Вау... Это всё твоё?"},
    {who: "zheka_t3000", text: "Всё моё. Я же T-3000."},
    {who: "zheka_t3000", text: "Мозг размером с планету, руки из титана."},
    {who: "evil_mahmud", text: "Опять хвастаешься."},
    {who: "zheka_t3000", text: "Завидуй молча, Махмуд."},
    {who: "artem",       text: "А что это за штука в центре?"},
    {who: "zheka_t3000", text: "Это портал. Я собрал его за 3 дня."},
    {who: "artem",       text: "За 3 дня?!"},
    {who: "zheka_t3000", text: "Я не сплю. Мне не надо."},
    {who: "evil_mahmud", text: "Он реально не спит. Странный."},
    {who: "zheka_t3000", text: "Зато я сделал то, что не смог бы обычный человек."},
    {who: "narrator",    text: "Жека подошёл к пульту управления."},
    {who: "zheka_t3000", text: "Портал ведёт на планету грязи."},
    {who: "zheka_t3000", text: "Планета, где никто не убирается 1000 лет."},
    {who: "artem",       text: "1000 лет? Там же всё сгнило..."},
    {who: "evil_mahmud", text: "Именно. Там Прайм."},
    {who: "evil_mahmud", text: "Он хочет её очистить."},
    {who: "evil_mahmud", text: "Уничтожить всё живое на ней."},
    {who: "artem",       text: "И мы его остановим."},
    {who: "zheka_t3000", text: "Именно."},
    {who: "zheka_t3000", text: "Но сначала - босс планеты."},
    {who: "artem",       text: "Кто?"},
    {who: "evil_mahmud", text: "Гладков Матвей."},
    {who: "evil_mahmud", text: "Худой тип. Чуть-чуть в говне."},
    {who: "zheka_t3000", text: "И его пёс - Борзен."},
    {who: "zheka_t3000", text: "Пёс с душой человека. Мыслит как человек."},
    {who: "artem",       text: "Пёс, который думает?"},
    {who: "evil_mahmud", text: "Это отдельная проблема."},
    {who: "evil_mahmud", text: "С ним нельзя договориться."},
    {who: "zheka_t3000", text: "Можно. Если знать что сказать."},
    {who: "artem",       text: "А что говорить?"},
    {who: "zheka_t3000", text: "Увидишь. По ходу дела разберёмся."},
    {who: "narrator",    text: "Жека нажал кнопку на пульте."},
    {who: "narrator",    text: "Портал загудел и засиял фиолетовым."},
    {who: "zheka_t3000", text: "Готово. Портал открыт."},
    {who: "evil_mahmud", text: "Артём. Готов?"},
    {who: "artem",       text: "..."},
    {who: "artem",       text: "Да."},
    {who: "artem",       text: "За Жеку. За Махмуда. За всех."},
    {who: "evil_mahmud", text: "Хорошо сказал."},
    {who: "zheka_t3000", text: "Тогда вперёд."},
    {who: "narrator",    text: "Трое шагнули в портал..."},
    {who: "narrator",    text: "[ ГЛАВА 3 - ПЛАНЕТА ГРЯЗИ ]"}
];